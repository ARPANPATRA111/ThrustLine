---
import Base from '../layouts/Base.astro';
import { GAME_URL } from '../config';
---

<Base title="Lost in the acid · THRUSTLINE" noindex>
  <section class="lost">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1 class="h2">Lost in the <em>acid.</em></h1>
      <p class="lead">This page burned up. Fly back home or jump straight into a match.</p>
      <div class="ctas">
        <a class="btn primary lg" href={GAME_URL}>Play now</a>
        <a class="btn lg" href="/">Home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 100svh; display: grid; place-items: center; text-align: center; padding: 120px 0 80px;
    background: radial-gradient(60% 40% at 50% 100%, rgba(124, 255, 79, 0.18), transparent 70%), var(--bg1);
  }
  .lost .kicker { justify-content: center; }
  .ctas { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
</style>
