---
import { FAQ } from '../data/faq';
---

<div class="faq" data-reveal>
  {FAQ.map((item) => (
    <details>
      <summary><h2>{item.q}</h2><span class="plus" aria-hidden="true"></span></summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; align-items: start; }
  details { border-radius: 12px; border: 1px solid var(--line); background: rgba(14, 20, 44, 0.6); transition: border-color 0.2s; }
  details[open] { border-color: rgba(34, 211, 238, 0.45); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  h2 { font: 600 16px/1.35 var(--ui); }
  .plus { position: relative; flex: none; width: 16px; height: 16px; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 2px; right: 2px; top: 7px; height: 2px; border-radius: 2px; background: var(--cyan); transition: transform 0.25s; }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  details p { padding: 0 16px 16px; font-size: 15px; color: var(--soft); }
  @media (max-width: 760px) { .faq { grid-template-columns: 1fr; } }
</style>
