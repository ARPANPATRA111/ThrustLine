---
import { Image } from 'astro:assets';
import PlayStoreButton from './PlayStoreButton.astro';
import { GAME_URL } from '../config';
import kiln from '../assets/shots/kiln-3.webp';
---

<section class="cta" aria-labelledby="cta-title">
  <Image src={kiln} alt="" widths={[800, 1600]} sizes="100vw" class="bg" />
  <div class="shade" aria-hidden="true"></div>
  <div class="wrap inner" data-reveal>
    <h2 id="cta-title" class="h2">Your squad is <em>one link away.</em></h2>
    <p class="lead">Jump into Quick Play now, or start a room and send the invite. Rounds take a few minutes; the rematch takes one tap.</p>
    <div class="ctas">
      <a class="btn primary lg" href={GAME_URL}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor" /></svg>
        Play free now
      </a>
      <PlayStoreButton />
    </div>
  </div>
</section>

<style>
  .cta { position: relative; isolation: isolate; overflow: hidden; padding: clamp(90px, 12vw, 150px) 0; text-align: center; }
  .cta :global(.bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
  .shade {
    position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(70% 90% at 50% 50%, rgba(5, 8, 15, 0.84), rgba(5, 8, 15, 0.96)), linear-gradient(180deg, var(--bg1), transparent 25%, transparent 75%, var(--bg0));
  }
  .inner { display: grid; justify-items: center; }
  .lead { max-width: 620px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 34px; }
  @media (max-width: 560px) { .ctas :global(.btn) { width: 100%; } }
</style>
