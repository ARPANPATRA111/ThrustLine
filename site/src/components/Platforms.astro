---
import PlayStoreButton from './PlayStoreButton.astro';
import { GAME_URL } from '../config';
---

<section id="play" class="section platforms" aria-labelledby="platforms-title">
  <div class="wrap">
    <div class="section-head center" data-reveal>
      <p class="kicker">Play anywhere</p>
      <h2 id="platforms-title" class="h2">Browser today. <em>Android next.</em></h2>
      <p class="lead">Same game, same servers, same progress. Pick the screen you have.</p>
    </div>
    <div class="grid">
      <article class="card plat" data-reveal>
        <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4" width="19" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M2.5 8h19M8 21h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <h3>In your browser</h3>
        <p>Open the link and play on any phone, tablet or laptop with a modern browser. Nothing to install, nothing to sign.</p>
        <a class="btn primary" href={GAME_URL}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor" /></svg>
          Play now
        </a>
      </article>
      <article class="card plat android" data-reveal="2">
        <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <h3>On Android</h3>
        <p>A tiny app under 1 MB that opens full screen in landscape, opens invite links, and shares your level with Chrome.</p>
        <PlayStoreButton size="" />
      </article>
      <article class="card plat" data-reveal="3">
        <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9h4M9 7v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><circle cx="15.5" cy="10" r="1.2" fill="currentColor" /><circle cx="17.5" cy="12.5" r="1.2" fill="currentColor" /><path d="M6.5 5h11A4.5 4.5 0 0 1 22 9.6l-.6 6.2a2.6 2.6 0 0 1-4.6 1.4L15 15H9l-1.8 2.2a2.6 2.6 0 0 1-4.6-1.4L2 9.6A4.5 4.5 0 0 1 6.5 5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        <h3>Your controls</h3>
        <p>Twin-stick touch, a gamepad, or keyboard and mouse. Remap every key, and switch on the colour-blind palette.</p>
        <ul class="tags"><li class="chip">Touch</li><li class="chip">Gamepad</li><li class="chip">Keyboard + mouse</li></ul>
      </article>
    </div>
  </div>
</section>

<style>
  .platforms { background: radial-gradient(70% 60% at 50% 100%, rgba(34, 211, 238, 0.1), transparent 70%), var(--bg0); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .plat { padding: 30px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.25s; }
  .plat:hover { border-color: rgba(34, 211, 238, 0.4); }
  .glyph { width: 46px; height: 46px; color: var(--cyan); }
  .android .glyph { color: var(--acid); }
  h3 { margin-top: 6px; font: 400 25px/1.1 var(--display); }
  .plat p { color: var(--soft); margin-bottom: 10px; }
  .plat > :global(.btn) { margin-top: auto; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
