---
import Logo from './Logo.astro';
import { GAME_URL } from '../config';

const links = [
  { href: '/gameplay/', label: 'Gameplay' },
  { href: '/modes/', label: 'Modes & Maps' },
  { href: '/arsenal/', label: 'Arsenal' },
  { href: '/how-to-play/', label: 'How to play' },
  { href: '/download/', label: 'Download' },
  { href: '/faq/', label: 'FAQ' },
];
const path = Astro.url.pathname;
---

<header class="top">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="THRUSTLINE home">
      <Logo />
      <span class="word">THRUST<span>LINE</span></span>
    </a>
    <nav class="links" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a class="btn primary play" href={GAME_URL} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor" /></svg>
      Play now
    </a>
    <details class="menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </summary>
      <nav class="sheet" aria-label="Mobile">
        {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
        <a class="btn primary" href={GAME_URL} rel="noopener">Play now</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .top {
    position: fixed; inset: 0 0 auto; z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: linear-gradient(180deg, rgba(5, 8, 15, 0.82), rgba(5, 8, 15, 0.55));
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgba(130, 150, 230, 0.12);
  }
  .bar { display: flex; align-items: center; gap: 24px; height: 68px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
  .word { font: 400 21px/1 var(--display); letter-spacing: 0.04em; }
  .word span { background: var(--brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .links { display: flex; gap: 6px; margin-left: auto; }
  .links a {
    padding: 9px 12px; border-radius: 10px; text-decoration: none;
    font: 600 15px/1 var(--ui); letter-spacing: 0.06em; color: var(--soft);
    transition: color 0.15s, background 0.15s;
  }
  .links a:hover, .links a[aria-current] { color: var(--ink); background: rgba(255, 255, 255, 0.06); }
  .links a[aria-current] { box-shadow: inset 0 -2px 0 var(--cyan); }
  .play { --h: 42px; padding: 0 18px; font-size: 14px; white-space: nowrap; }
  .menu { display: none; position: relative; }
  .menu summary {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; cursor: pointer;
    list-style: none; border: 1px solid var(--line-strong); background: rgba(255, 255, 255, 0.04);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary svg { width: 22px; height: 22px; }
  .sheet {
    position: absolute; right: 0; top: 54px; width: min(280px, 86vw); padding: 10px;
    display: grid; gap: 4px; border-radius: 16px; border: 1px solid var(--line-strong);
    background: rgba(10, 15, 34, 0.97); box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7);
  }
  .sheet a:not(.btn) { padding: 12px 14px; border-radius: 10px; text-decoration: none; font-weight: 600; color: var(--soft); }
  .sheet a:not(.btn):hover, .sheet a[aria-current] { background: rgba(255, 255, 255, 0.06); color: var(--ink); }
  .sheet .btn { margin-top: 6px; }

  @media (max-width: 1080px) {
    .links { display: none; }
    .play { margin-left: auto; }
    .menu { display: block; }
  }
  @media (max-width: 420px) {
    .word { font-size: 18px; }
    .play { padding: 0 14px; }
    .bar { gap: 10px; }
  }
</style>
